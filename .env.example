# Copy to .env and fill in for your machine. Never commit the real .env file.

# A real Postgres connection string. The app refuses to start without one —
# there is no local-storage or in-memory fallback for shared data.
DATABASE_URL=postgres://user:password@localhost:5432/ecrm_hub

# Port the server listens on.
PORT=3000

# How long a signed-in session stays valid, in hours.
SESSION_TTL_HOURS=336
